{
  "name": "loon",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "selftest": "electron . --selftest --keep-bubble",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "chrono-node": "^2.10.1",
    "defuddle": "^0.19.4",
    "franc-min": "^6.2.0",
    "harper.js": "^2.10.0",
    "kokoro-js": "^1.2.1",
    "linkedom": "^0.18.13",
    "node-llama-cpp": "^3.22.1",
    "pdfjs-dist": "^6.4.299",
    "quicktype-core": "^26.0.0",
    "sherpa-onnx-node": "^1.13.8",
    "tesseract.js": "^7.0.0",
    "wordpos": "^2.1.0",
    "ws": "^8.22.0"
  },
  "description": "A free, open-source, local-first AI black cat that lives on your Mac's screen and helps you explain, compare, write and act.",
  "license": "MIT",
  "author": "Akankshya (https://github.com/akankshyam07)",
  "homepage": "https://github.com/akankshyam07/loon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akankshyam07/loon.git"
  },
  "bugs": {
    "url": "https://github.com/akankshyam07/loon/issues"
  },
  "keywords": [
    "electron",
    "chrome-extension",
    "desktop-pet",
    "ai-assistant",
    "local-first",
    "privacy",
    "llama.cpp",
    "offline",
    "macos"
  ],
  "build": {
    "appId": "dev.loon.desktop",
    "productName": "Loon",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main/**",
      "brain/**",
      "renderer/**",
      "extension/**",
      "test/selftest*.js",
      "test/fixtures/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v3/{linux,win32}/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-arm64/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@browsermt/**",
      "brain/translator-host.mjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Loon listens only while you talk to it (after \u2325\u21e7V or the optional \"Hey Loon\"). Audio is processed on this Mac and never saved.",
        "NSAppleEventsUsageDescription": "Loon adds reminders and calendar events only after you confirm them.",
        "NSScreenCaptureUsageDescription": "Loon reads the screen region you pick with \u2325\u21e7S, and your screen when you ask it to point at something (\u2325\u21e7T). It reads on this Mac and keeps no screenshots."
      }
    },
    "dmg": {
      "title": "Loon"
    }
  }
}
